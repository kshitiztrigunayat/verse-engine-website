{
  "framework": null,
  "installCommand": "cd website && npm ci",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/plug-ins",
      "destination": "/plugins",
      "permanent": true
    },
    {
      "source": "/engine",
      "destination": "/docs/what-is-verse-engine",
      "permanent": true
    },
    {
      "source": "/bench",
      "destination": "/docs/guides/spatial-bench",
      "permanent": true
    },
    {
      "source": "/developers/playground",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/developers/adoption",
      "destination": "/developers",
      "permanent": true
    },
    {
      "source": "/docs/api",
      "destination": "/docs/scenes-api",
      "permanent": true
    },
    {
      "source": "/docs/authentication",
      "destination": "/docs/api-quickstart",
      "permanent": true
    },
    {
      "source": "/docs/blender",
      "destination": "/docs/guides/publish-from-blender",
      "permanent": true
    },
    {
      "source": "/docs/concepts",
      "destination": "/docs/how-streaming-works",
      "permanent": true
    },
    {
      "source": "/docs/webhooks",
      "destination": "/docs/developers",
      "permanent": true
    },
    {
      "source": "/docs/fixing-doors-and-windows",
      "destination": "/docs/guides/instant-home",
      "permanent": true
    },
    {
      "source": "/docs/floor-plan-to-3d-home",
      "destination": "/docs/guides/floor-plan-to-3d",
      "permanent": true
    },
    {
      "source": "/docs/upload-your-first-scene",
      "destination": "/docs/getting-started",
      "permanent": true
    },
    {
      "source": "/docs/materials-and-lighting",
      "destination": "/docs/guides/fidelity-mode",
      "permanent": true
    },
    {
      "source": "/docs/unity",
      "destination": "/docs/guides/publish-from-unity",
      "permanent": true
    },
    {
      "source": "/docs/unreal",
      "destination": "/docs/guides/publish-from-unreal",
      "permanent": true
    },
    {
      "source": "/docs/start-a-live-tour",
      "destination": "/docs/guides/tour-together",
      "permanent": true
    },
    {
      "source": "/docs/supported-file-types",
      "destination": "/docs/guides/what-you-can-upload",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/docs/what-is-verse-engine",
      "permanent": true
    },
    {
      "source": "/(use-cases/ecommerce|use-cases/e-commerce|use-cases/commerce){/}?",
      "destination": "/use-cases/3d-commerce",
      "statusCode": 301
    },
    {
      "source": "/(use-cases/real-estate|use-cases/architecture){/}?",
      "destination": "/use-cases/architecture-real-estate",
      "statusCode": 301
    },
    {
      "source": "/(ai|ai-and-3d-infrastructure){/}?",
      "destination": "/ai-3d-infrastructure",
      "statusCode": 301
    },
    {
      "source": "/(lyon|demo/lyon){/}?",
      "destination": "/demos/lyon",
      "statusCode": 301
    },
    {
      "source": "/(.+)/",
      "destination": "/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/((?!_h/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/_h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|content)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}